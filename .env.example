# ==============================================================================
# Gemini Voice Transcriber — قالب متغيرات البيئة (الإصدار 2.0.0-phase7.1)
# ==============================================================================
# انسخ هذا الملف إلى .env (محلياً) أو أدخل القيم في لوحة الاستضافة (Startup → Variables).
# القيم أدناه هي الموصى بها لحاوية 512MB RAM على Bot-Hosting / Pterodactyl.
# كل متغير اختياري ما لم يُذكر «مطلوب». القيمة الافتراضية في الكود مذكورة بين قوسين.
# لا تضع .env في النسخ الاحتياطي العام ولا في Git (مستثنى في .gitignore).

# ------------------------------------------------------------------ 1) الأساسيات (مطلوبة)
# مفاتيح Gemini من Google AI Studio، مفصولة بفواصل (تدوير تلقائي + تُدمج مع keys.json عند كل تشغيل)
GEMINI_API_KEYS=AIzaSy_key_1,AIzaSy_key_2

# بوت تليجرام من @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_BOT_USERNAME=@YourBotUsername

# مطلوب: حصر البوت عليك فقط. لو فاضي البوت يرفض الجميع.
# لمعرفته: شغّل البوت وأرسل /start، سيُطبع الـ ID في الكونسول.
TELEGRAM_CHAT_ID=123456789

# ------------------------------------------------------------------ 2) التخزين والموارد (مهم للاستضافة)
# مجلد البيانات الدائم (المفاتيح/الجلسات/الأرشيف/النسخ/السجلات). يجب أن يكون خارج ملفات الكود
# حتى لا يُمسح عند إعادة رفع ZIP. (الافتراضي: مجلد الكود نفسه — غير مستحسن على الاستضافة)
DATA_DIR=/home/container/data

# عدد خيوط التفريغ المتوازية. على 512MB: 2 (أو 1). كل فويس كبير يحتاج ≈ 4× حجمه في الذاكرة
# (base64 + JSON)؛ تجاوز الرام = OOM Killer يقتل العملية بـ SIGKILL بلا إغلاق رشيق. (الافتراضي 2)
BOT_WORKERS=2

# سقف حجم الملف الصوتي بالميجابايت. على 512MB: 20 مع BOT_WORKERS=2. (الافتراضي 25)
MAX_UPLOAD_MB=20

# منفذ الويب. على bot-hosting.net يُلتقط SERVER_PORT تلقائياً إن لم يُضبط PORT. (الافتراضي 8080)
# PORT=8080

# ------------------------------------------------------------------ 3) أمان واجهة الويب (13 §1.1)
# توكن واجهة الويب و /api/*. لو تركته فاضياً على مضيف عام (0.0.0.0 — حال الاستضافة) يولّد البوت
# توكناً عشوائياً (32 hex) عند كل إقلاع ويطبعه في الكونسول ويرسله لشاتك. انسخه وثبّته هنا حتى لا يتغير.
# localhost (127.0.0.1) مفتوح دائماً بلا توكن.
WEB_ACCESS_TOKEN=

# 1 = ويب بلا توكن على مضيف عام. غير مستحسن إطلاقاً (أي أحد يستهلك حصتك ويقرأ جلساتك). (الافتراضي 0)
WEB_ALLOW_OPEN=0

# 1 فقط لو البوت خلف reverse proxy موثوق (Nginx/Cloudflare) — عندها يُعتمد X-Forwarded-For
# في حد الطلبات. الافتراضي يتجاهل الترويسة لأنها قابلة للتزوير. (الافتراضي 0)
TRUST_PROXY=0

# حد طلبات التفريغ عبر الويب لكل IP في الدقيقة. (الافتراضي 30)
# WEB_RATE_LIMIT_PER_MIN=30

# ------------------------------------------------------------------ 4) التوقيت والإشعارات
# منطقة العرض: ساعة تصفير الكوتا ومعادل موعد النسخ الأسبوعي. الجدولة نفسها بتوقيت الخادم (UTC على
# الاستضافات) والنصوص تذكر الموعدين صراحة. (الافتراضي Africa/Cairo)
DISPLAY_TZ=Africa/Cairo

# رسالة «🚀 المنظومة اشتغلت» على تليجرام عند الإقلاع (تحمل توكن الويب المولَّد إن وُجد). (الافتراضي 1)
NOTIFY_ON_START=1

# ------------------------------------------------------------------ 5) النسخ الاحتياطي التلقائي (09 §5)
# BACKUP_WEEKLY_ENABLED=1          # 0 يعطّل النسخة الأسبوعية
# BACKUP_WEEKLY_DAY=fri            # mon..sun أو 0..6 أو اسم عربي
# BACKUP_HOUR=3                    # بتوقيت الخادم (UTC على الاستضافة = 05:00/06:00 القاهرة)
# (آخر 4 نسخ محلية في DATA_DIR/backups/ — /backups لعرضها وإرسالها، /restore_test لفحصها)

# ------------------------------------------------------------------ 6) السجلات والمراقبة (المرحلة 5)
# LOG_LEVEL=INFO                   # DEBUG لتفاصيل أكثر
# LOG_TO_FILE=1                    # ملف يومي في DATA_DIR/logs/ بجانب stdout
# LOG_RETENTION_DAYS=90
# LOG_TOTAL_MAX_MB=500
# DOCTOR_INTERVAL_MIN=60           # الفحص الدوري الصامت (0 يعطّله)

# ------------------------------------------------------------------ 7) التعافي الذاتي (الطبقات 0.5–4)
# 0 = عملية واحدة (الافتراضي والموصى به على Pterodactyl: اللوحة نفسها تعيد التشغيل عند الخروج).
# 1 = مشرف يعيد إطلاق العامل تلقائياً (الطبقة 4) — للاستضافات بلا إعادة تشغيل تلقائية.
SUPERVISED=0
# SHUTDOWN_GRACE=20                # ثوانٍ انتظار المهام الجارية عند SIGTERM
# QUEUE_MAX=50                     # سعة طابور الفويسات
# TRANSCRIBE_WORKERS=1             # نداءات Gemini المتزامنة (1 يحمي الحصة)

# ------------------------------------------------------------------ 8) خط الإنتاج والمساعد (المراحل 3–7)
# DELIVERY_MODE=dual               # dual | raw | polished  (يُعدَّل أيضاً بـ /mode و /set)
# DEFAULT_ROLE=general
# TEXT_ASSIST_MODEL=gemini-3.5-flash-lite   # نصي فقط — لا يُستخدم للتفريغ
# CONTEXT_ENABLED=1
# SMART_TITLE_ENABLED=1
# SET_MY_COMMANDS=1                # تسجيل الأوامر في زر Menu عند الإقلاع
# FEATURE_PLAN=1                   # /plan عبر Antigravity (AGENT_NAME, AGENT_TIMEOUT=180)
# CHAT_TTL_MIN=10                  # مدة وضع /chat

# ------------------------------------------------------------------ 9) للاستخدام المحلي فقط (ليس للاستضافة)
# RECORDINGS_DIR=C:\Users\username\Documents\VoiceRecordings

# ------------------------------------------------------------------ 10) المزود المحلي لتنظيم النصوص والتنظيم المتوازي
# أمر تشغيل سكربت محلي كـ CLI Runner لتنظيم النصوص (اتركه فارغاً للاكتشاف التلقائي لـ .local/shelby_polish.py إن وُجد)
# مسار محلي على ويندوز أو لينكس (استخدم علامات اقتباس إن احتوى المسار مسافات)
# LOCAL_POLISH_CMD=python .local/shelby_polish.py
# LOCAL_POLISH_TIMEOUT=8.0         # أقصى مهلة بالثواني للمنظم المحلي (الافتراضي 8.0)
# COMPARE_MODE=merged               # وضع المقارنة عند تفعيل منظم محلي: merged (مدمج مع تعديل صامت) | split (3 رسائل) | off (إيقاف)
#
# --- عقد بروتوكول السكربت المحلي (Black-Box CLI) — إلزامي لو كتبت سكربتك الخاص ---
# البوت يُمرّر على stdin نصاً واحداً بهذا الشكل الدقيق ثم يقرأ stdout:
#
#     <System Prompt>\n\n===USER_INPUT===\n<النص الخام>
#
# قواعد العقد:
#   1. افصل بين التعليمات والنص بفاصل ===USER_INPUT=== في سطر مستقل — البوت يعتمد عليه.
#   2. اقرأ stdin بترميز UTF-8 واكتب stdout بترميز UTF-8 (ويندوز: sys.stdin.reconfigure).
#   3. اكتب النص المنظم فقط على stdout. أي تشخيص/تحذير → stderr (يُحجب ويُسجَّل، لا يُرسل).
#   4. كود خروج 0 + stdout غير فارغ = نجاح. كود 0 + stdout فارغ = فشل «مخرج فارغ».
#   5. أي كوكيز/توكنات تضعها في سكربتك تبقى خارجه تماماً: لا تضع السكربت داخل المستودع
#      (.local/ مستثنى في .gitignore، وpack_deploy يستخدم قائمة بيضاء للملفات).
#   6. المهلة الزمنية يفرضها البوت (LOCAL_POLISH_TIMEOUT) — لا تعتمد على مهلة السكربت.
#
# قالب جاهز للنسخ: Antigravity/local_provider_template.py

# ------------------------------------------------------------------ 11) سلوك الطابور (قرار المالك موثَّق)
# QUEUE_SKIP_DEFERRED=0            # 0 = المهمة المؤجلة (نفاد كوتا/قاطع 5xx) تحجب ما بعدها حفاظاً على
#                                  #     ترتيب سياق الفويسات المترابطة  ← الافتراضي الحالي
#                                  # 1 = تخطّي المؤجلة وخدمة الجاهز فوراً (أسرع لكن يخلط الترتيب)
# QUEUE_MAX=50                     # سقف طول الطابور قبل رفض الطلبات الجديدة
