# ==============================================================
# Gemini Voice Transcriber - Environment Variables Template
# ==============================================================
# انسخ هذا الملف إلى .env وضع مفاتيحك الخاصة (أو أدخلها في لوحة الاستضافة Hosting)

# 1. مفاتيح Gemini API من Google AI Studio (مفصولة بفاصلة للتدوير التلقائي)
GEMINI_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2

# 2. بيانات بوت التليجرام من @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_BOT_USERNAME=@YourBotUsername

# 3. الـ Chat ID الخاص بك لحصر البوت عليك فقط (مطلوب — لو فاضي البوت يرفض الجميع)
#    طريقة معرفته: شغّل البوت وأرسل له /start، سيطبع الـ ID في الكونسول.
TELEGRAM_CHAT_ID=123456789

# 4. مسار مجلد التسجيلات (للاستخدام المحلي فقط على الكمبيوتر)
RECORDINGS_DIR=C:\Users\USER\Documents\تسجيلات الصوت

# 5. (اختياري) توكن وصول لواجهة الويب. فاضي = مفتوح بالكامل (منظومة شخصية).
#    لو ضبطته، الواجهة تطلبه مرة واحدة وتحفظه في المتصفح. localhost مفتوح دائماً.
WEB_ACCESS_TOKEN=

# 6. (اختياري) منفذ الويب. على bot-hosting.net يُلتقط SERVER_PORT تلقائياً إن لم يُضبط PORT.
PORT=8080

# 7. (اختياري) الحد الأقصى لحجم الملف الصوتي بالميجابايت
MAX_UPLOAD_MB=25
