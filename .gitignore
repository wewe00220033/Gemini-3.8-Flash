# Secret Keys & Environment Variables (DO NOT COMMIT)
keys.txt
keys.json
.env
*.env

# Python Cache
__pycache__/
*.py[cod]
*$py.class
*.log

# OS generated files
.DS_Store
Thumbs.db

# Runtime state (jobs journal, resume data) — never commit (ghost-job trap: a stale line gets resumed at boot)
state/
*.ndjson
*.corrupt-*
data/
.smoke_failover/
glossary.json
roles.json
settings.json
transcripts/

# Phase 5 runtime artifacts (CCTV logs, incident reports, persistence probe) — never commit
logs/
incidents/
.persist_probe
